<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared UI + application logic consumed by every platform head (VRCFaceTracking.Desktop, VRCFaceTracking.Android).
    Keep this project free of platform-specific APIs: anything that differs per platform goes behind an interface in
    Contracts/Services and is registered by the head that owns it (see IPlatformServices).
  -->
  <PropertyGroup>
    <TargetFramework>$(VftTargetFramework)</TargetFramework>
    <RootNamespace>VRCFaceTracking</RootNamespace>
    <!-- Let the head's RID flow through to Core so it copies the matching native fti_osc (see Core's IsRidAgnostic) -->
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="Sentry.Extensions.Logging" />
    <PackageReference Include="System.Net.Http" />
    <PackageReference Include="System.Private.Uri" />
    <PackageReference Include="System.Text.RegularExpressions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VRCFaceTracking.Core\VRCFaceTracking.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Strings\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <StronglyTypedFileName>$(MSBuildProjectDirectory)\Strings\Resources.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>VRCFaceTracking.Strings</StronglyTypedNamespace>
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <Compile Update="Strings\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:models="clr-namespace:VRCFaceTracking.Core.Models;assembly=VRCFaceTracking.Core"
    x:DataType="vm:ModuleRegistryViewModel"
    x:Class="VRCFaceTracking.Views.ModuleRegistryPage">

    <Grid ColumnDefinitions="300,*">

        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,10,0">
            <Border Grid.Row="0" CornerRadius="6" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Find" FontSize="16" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="13" Text="Available Modules" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListBox
                    ItemsSource="{Binding ModuleInfos}"
                    SelectedItem="{Binding Selected}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:InstallableTrackingModule">
                            <Grid Height="56" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Text="{Binding ModuleName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Opacity="0.6"
                                               Text="{Binding AuthorName}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        x:Name="StateBadge">
                                    <TextBlock FontSize="11" Text="{Binding InstallationState}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <TextBlock
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.5"
                FontSize="16"
                Text="Select a module to view details" />

            <Border
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                CornerRadius="6"
                BorderThickness="1">
                <ScrollViewer Padding="20">
                    <StackPanel Spacing="14" DataContext="{Binding Selected}">

                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding ModuleName}" />
                                <TextBlock FontSize="13" Opacity="0.6" Text="{Binding AuthorName}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="InstallButton"
                                Classes="accent"
                                Click="InstallButton_Click"
                                Content="Install" />
                            <Button
                                x:Name="UninstallButton"
                                Click="UninstallButton_Click"
                                Content="Uninstall" />
                        </StackPanel>

                        <Separator />

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Top">

                            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="Version" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="Downloads" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Downloads}" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="Last Updated" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastUpdated, StringFormat='{}{0:d}'}" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="Module Page" Margin="0,8,0,0" />
                            <Button Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                                    Padding="0"
                                    Classes="hyperlink"
                                    Content="{Binding ModulePageUrl}"
                                    Click="OpenModulePage_Click" />

                            <TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="Description" Margin="0,16,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ModuleDescription}" TextWrapping="Wrap" Margin="0,16,0,0" />

                            <TextBlock Grid.Row="5" Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="Usage" Margin="0,8,0,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UsageInstructions}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
